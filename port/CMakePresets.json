{
    "version": 8,
    "configurePresets": [
        {
            "name": "clangcl",
            "hidden": true,
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/cmake/clangcl-toolchain.cmake"
        },
        {
            "name": "x64",
            "hidden": true,
            "inherits": "clangcl",
            "cacheVariables": {
                "SBSP_ARCH": "x64"
            }
        },
        {
            "name": "x86",
            "hidden": true,
            "inherits": "clangcl",
            "cacheVariables": {
                "SBSP_ARCH": "x86"
            }
        },
        {
            "name": "debug",
            "displayName": "USA DEBUG (CD) - x64",
            "inherits": "x64",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "SBSP_VARIANT": "DEBUG"
            }
        },
        {
            "name": "final",
            "displayName": "USA FINAL (CD) - x64",
            "inherits": "x64",
            "binaryDir": "${sourceDir}/build/final",
            "cacheVariables": {
                "SBSP_VARIANT": "FINAL"
            }
        },
        {
            "name": "eur-debug",
            "displayName": "EUR DEBUG (CD) - x64",
            "inherits": "x64",
            "binaryDir": "${sourceDir}/build/eur-debug",
            "cacheVariables": {
                "SBSP_VARIANT": "DEBUG",
                "SBSP_TERRITORY": "EUR"
            }
        },
        {
            "name": "eur-final",
            "displayName": "EUR FINAL (CD) - x64",
            "inherits": "x64",
            "binaryDir": "${sourceDir}/build/eur-final",
            "cacheVariables": {
                "SBSP_VARIANT": "FINAL",
                "SBSP_TERRITORY": "EUR"
            }
        },
        {
            "name": "x86-debug",
            "displayName": "USA DEBUG (CD) - x86",
            "inherits": "x86",
            "binaryDir": "${sourceDir}/build/x86-debug",
            "cacheVariables": {
                "SBSP_VARIANT": "DEBUG"
            }
        },
        {
            "name": "x86-final",
            "displayName": "USA FINAL (CD) - x86",
            "inherits": "x86",
            "binaryDir": "${sourceDir}/build/x86-final",
            "cacheVariables": {
                "SBSP_VARIANT": "FINAL"
            }
        },
        {
            "name": "x86-eur-debug",
            "displayName": "EUR DEBUG (CD) - x86",
            "inherits": "x86",
            "binaryDir": "${sourceDir}/build/x86-eur-debug",
            "cacheVariables": {
                "SBSP_VARIANT": "DEBUG",
                "SBSP_TERRITORY": "EUR"
            }
        },
        {
            "name": "x86-eur-final",
            "displayName": "EUR FINAL (CD) - x86",
            "inherits": "x86",
            "binaryDir": "${sourceDir}/build/x86-eur-final",
            "cacheVariables": {
                "SBSP_VARIANT": "FINAL",
                "SBSP_TERRITORY": "EUR"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "final",
            "configurePreset": "final"
        },
        {
            "name": "eur-debug",
            "configurePreset": "eur-debug"
        },
        {
            "name": "eur-final",
            "configurePreset": "eur-final"
        },
        {
            "name": "x86-debug",
            "configurePreset": "x86-debug"
        },
        {
            "name": "x86-final",
            "configurePreset": "x86-final"
        },
        {
            "name": "x86-eur-debug",
            "configurePreset": "x86-eur-debug"
        },
        {
            "name": "x86-eur-final",
            "configurePreset": "x86-eur-final"
        }
    ]
}
