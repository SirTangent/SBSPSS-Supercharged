# parkgrab's words, in makefile.gfx's order (SPRITES_ALL_IN): each switch
# applies to the files after it
list(TRANSFORM INGAMEFX_GFX_TRANS PREPEND graphics/ingamefx/ OUTPUT_VARIABLE _ingame)
list(TRANSFORM _ingame APPEND .bmp)
list(TRANSFORM PICKUP_GFX PREPEND graphics/pickups/ OUTPUT_VARIABLE _pickups)
list(TRANSFORM _pickups APPEND .bmp)
list(TRANSFORM UI_GFX_FONT PREPEND graphics/font/smallfont/ OUTPUT_VARIABLE _font)
list(TRANSFORM _font APPEND .bmp)
list(TRANSFORM UI_GFX_TRANS PREPEND graphics/ui/ OUTPUT_VARIABLE _ui)
list(TRANSFORM INGAMEFX_GFX_TRANS_NONROT_NONCLIP PREPEND graphics/ingamefx/ OUTPUT_VARIABLE _nonrot)
list(TRANSFORM _nonrot APPEND .bmp)
list(TRANSFORM FRONTEND_GFX_TRANS_NO_ROT PREPEND graphics/frontend/ OUTPUT_VARIABLE _feNoRot)
list(TRANSFORM FRONTEND_GFX_TRANS PREPEND graphics/frontend/ OUTPUT_VARIABLE _fe)
set(_actorSpr)
foreach(_a IN LISTS ACTOR_SPRITES)
    list(APPEND _actorSpr graphics/Characters/${_a}/Render/Psx/${_a}_*.bmp)
endforeach()
list(TRANSFORM SFX_GFX PREPEND graphics/sfx/ OUTPUT_VARIABLE _sfx)
set(SPRITES_WORDS
    -c+ -z+ ${_ingame} ${_pickups} ${_font} ${_ui}
    -c- -z-
    -c- -q- -z+ -r- ${_nonrot} -q+
    -r- -z+ ${_feNoRot} -r+ ${_fe} -z-
    -r- -c+ -z+ ${_actorSpr}
    -z- -c+ ${_sfx} -z+ -c-)
# the files those words name, for the dependencies (the five sprite actors
# by their whole Render/Psx folder, as makefile.gfx had it)
set(SPRITES_FILES ${_ingame} ${_pickups} ${_font} ${_ui} ${_nonrot} ${_feNoRot} ${_fe} ${_sfx})
foreach(_a IN LISTS ACTOR_SPRITES)
    file(GLOB _f CONFIGURE_DEPENDS ${SBSP_ROOT}/graphics/Characters/${_a}/Render/Psx/*)
    list(APPEND SPRITES_ACTOR_DEPS ${_f})
endforeach()

