<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The application manifest every PC exe carries (sbsp.rc; issue #62).
     The execution level and the supportedOS list are what MinGW's
     default-manifest.o gives an exe that has none, so the MinGW exes are
     declared exactly as before and the clang-cl ones gain the same list.
     activeCodePage UTF-8 (Windows 10 1903 and later; older systems ignore
     it) makes the process ANSI code page UTF-8: argv, getenv, fopen,
     _mkdir and GetModuleFileNameA then carry any path, not only the ones
     the system code page can spell.  No dpiAware: SDL sets DPI awareness
     itself at run time. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows Vista -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
