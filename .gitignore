# Build outputs and local debris (Win11 port work)
out/
# synthetic-disc scratch dirs the unit tests stage at the repo root
*_test_tmp/
data/Scripts/defs/trans.scr
*.stackdump
.idea/
# a file literally named nul, from a `>nul` recipe under an msys sh (issue
# #15); none is left in the makefiles, but older trees can still have one
nul
# the copy port/build-psx.sh drops at the root for ccpsx (the tracked
# originals live under tools/psyq/bin/)
/sn.ini
port/build/
# compiled SPIR-V binaries - intermediate output of gen_spv.py; the .spv.h
# headers it derives from them are what's actually committed and compiled in
*.spv
# generated by the PSX build (makefile.gaz)
source/system/DEBUG/
source/system/FINAL/
statcov.txt
stats.txt
# M8 shell: tester zips, pad recordings kept by a failed route, test sessions
*.zip
*.rec.pad
sessions/

# the port's Python scripts import each other (port/tools/buildenv.py)
__pycache__/
